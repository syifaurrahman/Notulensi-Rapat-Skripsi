# ── AKTIFKAN REWRITE ENGINE Apache ──────────────────────────
RewriteEngine On

# 1. Force Redirect: Ubah akses langsung file .php ke tanpa ekstensi
# Hanya lakukan redirect jika request method-nya BUKAN POST
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internal Rewrite: Petakan URL tanpa ekstensi ke file .php aslinya
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
